# Docker Compose host port mappings. These do not change in-container service ports.
POSTGRES_PORT=5600
REDIS_PORT=6379
STREAM_LITE_API_PORT=8000
STREAM_LITE_DASHBOARD_PORT=8501
STREAM_LITE_BROKER_PROFILE=redis_streams
STREAM_LITE_PROCESSING_ENGINE=spark
STREAM_LITE_WATCH_ROOT=/data/sources
STREAM_LITE_OUTPUT_ROOT=/data/outputs
STREAM_LITE_QUARANTINE_ROOT=/data/quarantine
STREAM_LITE_DATABASE_URL=postgresql://stream_lite:stream_lite@postgres:5432/stream_lite
STREAM_LITE_REDIS_URL=redis://redis:6379/0
STREAM_LITE_DEBUG=false
STREAM_LITE_FILE_STABILITY_SECONDS=2
STREAM_LITE_MAX_FILE_SIZE_MB=100
STREAM_LITE_RETRY_MAX_ATTEMPTS=3
STREAM_LITE_RETRY_INITIAL_BACKOFF_SECONDS=1
STREAM_LITE_RETRY_BACKOFF_MULTIPLIER=2
STREAM_LITE_RETRY_MAX_BACKOFF_SECONDS=30
STREAM_LITE_RETRY_JITTER_ENABLED=true
STREAM_LITE_DASHBOARD_PRESENTATION_FILE=/app/config/dashboard_presentation.yaml
STREAM_LITE_LOG_LEVEL=INFO
STREAM_LITE_RECONCILIATION_INTERVAL_SECONDS=10
