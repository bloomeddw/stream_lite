{
  "title": "StandardError",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{2,64}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "field": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "resource_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "current_state": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "error_code",
    "message",
    "field",
    "resource_id",
    "current_state",
    "correlation_id"
  ]
}
